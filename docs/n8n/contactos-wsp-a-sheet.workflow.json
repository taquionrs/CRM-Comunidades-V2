      "parameters": {
        "jsCode": "const entrada = $('Webhook (desde Supabase)').first().json.body;\nconst rec = entrada.record || {};\nconst resp = $input.first().json;\nconst com = (Array.isArray(resp) ? resp[0] : resp) || {};\n\nconst ahora = rec.recibido_en ? new Date(rec.recibido_en) : new Date();\nconst zona = 'America/Argentina/Buenos_Aires';\nconst fecha = new Intl.DateTimeFormat('en-CA', { timeZone: zona }).format(ahora);\nconst hora = new Intl.DateTimeFormat('en-GB', { timeZone: zona, hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(ahora);\n\nconst contacto = (rec.payload && rec.payload.contact) || {};\nconst nombre = String(contacto.name || contacto.first_name || '').trim();\n\n// Nombre de la pestaña en la planilla, según cliente y comunidad\nconst HOJAS = {\n  'Cortado en Jarrito / Boedo': 'Cortado-Boedo',\n  'Cortado en Jarrito / Villa Devoto': 'Cortado-Devoto',\n  'Cortado en Jarrito / Palermo': 'Cortado-Palermo',\n  'Cortado en Jarrito / Cortado en Jarrito (general)': 'Cortado-General',\n  'Todo un País / La Toma': 'Todounpais-LaToma',\n  'Todo un País / Quines': 'Todounpais-Quines',\n  'Todo un País / San Luis Capital': 'Todounpais-SanLuis',\n  'Todo un País / Todo un País (general)': 'Todounpais-General',\n};\nconst cliente = (com.cliente && com.cliente.nombre) || '';\nconst hoja = HOJAS[cliente + ' / ' + (com.nombre || '')] || 'SIN-HOJA';\n\nreturn [{ json: {\n  Hoja: hoja,\n  Fecha: fecha,\n  Hora: hora,\n  'Teléfono': '+' + String(rec.telefono_id),\n  Nombre: nombre\n} }];"
      },
