      "credentials": {
        "httpCustomAuth": { "id": "REEMPLAZAR", "name": "Supabase CRM (Custom Auth)" }
      }
    },
    {
      "parameters": {
        "jsCode": "const entrada = $('Webhook (desde Supabase)').first().json.body;\nconst rec = entrada.record || {};\nconst resp = $input.first().json;\nconst com = (Array.isArray(resp) ? resp[0] : resp) || {};\n\nconst ahora = rec.recibido_en ? new Date(rec.recibido_en) : new Date();\nconst zona = 'America/Argentina/Buenos_Aires';\nconst fecha = new Intl.DateTimeFormat('en-CA', { timeZone: zona }).format(ahora);\nconst hora = new Intl.DateTimeFormat('en-GB', { timeZone: zona, hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(ahora);\n\nconst contacto = (rec.payload && rec.payload.contact) || {};\nconst nombre = String(contacto.name || contacto.first_name || '').trim();\n// El nombre de la hoja es el de la comunidad; Google Sheets no admite estos caracteres en el nombre de una hoja.\nconst hoja = String(com.nombre || 'Sin comunidad').replace(/[\\[\\]*\\/\\\\?:]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 100);\n\nreturn [{ json: {\n  Hoja: hoja,\n  Fecha: fecha,\n  Hora: hora,\n  'Teléfono': '+' + String(rec.telefono_id),\n  Nombre: nombre,\n  Cliente: (com.cliente && com.cliente.nombre) || ''\n} }];"
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Armar fila",
