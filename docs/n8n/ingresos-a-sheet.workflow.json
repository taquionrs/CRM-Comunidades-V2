        "jsCode": "const crypto = require('crypto');\nconst entrada = $('Webhook (desde Supabase)').first().json.body;\nconst rec = entrada.record || {};\nconst com = $input.first().json || {};\n\nconst ahora = rec.recibido_en ? new Date(rec.recibido_en) : new Date();\nconst zona = 'America/Argentina/Buenos_Aires';\nconst fecha = new Intl.DateTimeFormat('en-CA', { timeZone: zona }).format(ahora);\nconst hora = new Intl.DateTimeFormat('en-GB', { timeZone: zona, hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(ahora);\n\nconst id = String(rec.telefono_id || '');\nconst canal = id.startsWith('ig:') ? 'Instagram' : 'WhatsApp';\nconst persona = crypto.createHash('sha256').update(id).digest('hex').slice(0, 10);\nconst evento = entrada.table === 'clic_me_sumo' ? 'Clic en Me sumo' : 'Entrada al flow';\n\nreturn [{ json: {\n  Fecha: fecha,\n  Hora: hora,\n  Cliente: (com.cliente && com.cliente.nombre) || '',\n  Comunidad: com.nombre || '',\n  Canal: canal,\n  Evento: evento,\n  Persona: persona\n} }];"
